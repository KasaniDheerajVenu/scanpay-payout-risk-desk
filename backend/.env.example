SCANPAY_LOG_LEVEL=INFO
# Use a dedicated synthetic database for development.
SCANPAY_DATABASE_URL=postgresql+psycopg://scanpay_test:replace-me@127.0.0.1:55432/scanpay_test
# Optional direct URL for Alembic. Keep it pointed at the same database.
# SCANPAY_MIGRATION_DATABASE_URL=postgresql+psycopg://scanpay_test:replace-me@127.0.0.1:55432/scanpay_test
SCANPAY_DATABASE_POOL_SIZE=5
SCANPAY_DATABASE_MAX_OVERFLOW=5
SCANPAY_DATABASE_TIMEOUT_SECONDS=5

SCANPAY_APP_MODE=local
# Generate a fresh secret with secrets.token_urlsafe(48) and supply it privately.
# SCANPAY_AUTH_SIGNING_SECRET=<generated secret>
SCANPAY_AUTH_SESSION_SECONDS=1800
SCANPAY_AUTH_COOKIE_NAME=scanpay_session
# Defaults to false in local mode and true in demo mode.
# SCANPAY_AUTH_COOKIE_SECURE=true
SCANPAY_AUTH_COOKIE_SAMESITE=lax
# Enable for cross-origin frontend requests from SCANPAY_TRUSTED_ORIGINS.
SCANPAY_CORS_ENABLED=false
# Demo mode requires explicit HTTPS origins and rejects insecure cookies.
SCANPAY_TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
SCANPAY_LOGIN_RATE_LIMIT=5
SCANPAY_LOGIN_RATE_WINDOW_SECONDS=300
SCANPAY_LOGIN_RATE_MAX_ENTRIES=4096

# Ingestion bounds. The total includes multipart framing for HTTP requests.
SCANPAY_UPLOAD_MAX_FILE_BYTES=4194304
SCANPAY_UPLOAD_MAX_TOTAL_BYTES=16777216
SCANPAY_UPLOAD_MAX_ROWS_PER_FILE=100000
SCANPAY_UPLOAD_MAX_FIELD_CHARS=4096
