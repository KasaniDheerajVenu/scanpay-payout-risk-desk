+def infer_pending(
+    rows: tuple[ObservationAnalysis, ...],
+    model: FittedModel | None,
+    draft: ModelVersionDraft,
+    policy: MLPolicy,
+) -> tuple[MLFinding, ...]:
+    if model is not None:
+        try:
+            scores = model.score_many(tuple(row.vector for row in rows))
+        except ModelError:
+            # Retry separately so malformed rows keep their own diagnostic and
+            # do not prevent scoring of the other pending payouts.
+            pass
+        else:
+            return tuple(
+                infer(row, model, draft, policy, scored=score)
+                for row, score in zip(rows, scores, strict=True)
+            )
+    return tuple(infer(row, model, draft, policy) for row in rows)
