diff --git a/backend/tests/integration/test_ml_joint_profile.py b/backend/tests/integration/test_ml_joint_profile.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/integration/test_ml_joint_profile.py
@@ -0,0 +1,93 @@
+import subprocess
+import sys
+from io import BytesIO
+from pathlib import Path
+
+from sqlalchemy import select
+from test_evaluation import evaluation_db as evaluation_db
+
+from app.models import EvaluationRun, ModelVersion, PayoutDecision
+from app.models.values import FileType
+from app.schemas.ingestion import InputFile
+from app.services.csv_source import import_options
+from app.services.evaluate_batch import evaluate_batch
+from app.services.ingestion_service import ingest
+
+
+def test_database_learns_joint_volume_and_gratuity_profile(evaluation_db, tmp_path):
+    database, settings, admin, _ = evaluation_db
+    fixture = tmp_path / "joint-profile"
+    script = Path(__file__).resolve().parents[3] / "scripts" / "active_ml_fixture.py"
+    subprocess.run([sys.executable, str(script), str(fixture)], check=True)
+    names = {
+        FileType.TEAMS: "teams.csv",
+        FileType.HISTORY_TRANSACTIONS: "transactions_history.csv",
+        FileType.HISTORY_PAYOUTS: "payouts_history.csv",
+        FileType.LATEST_TRANSACTIONS: "transactions_10nov.csv",
+        FileType.PENDING_PAYOUTS: "payouts_pending.csv",
+    }
+    files = {
+        kind: InputFile(name, BytesIO((fixture / name).read_bytes()))
+        for kind, name in names.items()
+    }
+    options = import_options("INITIAL", "2026-04-14T10:00")
+    batch, created = ingest(database, settings, admin, files, options)
+    assert created
+    for name in names.values():
+        (fixture / name).unlink()
+    result = evaluate_batch(database, admin, batch.batch_id)
+    with database.session() as session:
+        run = session.get(EvaluationRun, result.run.run_id)
+        model = session.get(ModelVersion, run.model_version_id)
+        decisions = {
+            row.payout_id: row
+            for row in session.scalars(
+                select(PayoutDecision).where(PayoutDecision.run_id == result.run.run_id)
+            )
+        }
+        print("joint profile", model.status, model.anomaly_threshold)
+        print(
+            {
+                key: model.metrics[key]
+                for key in (
+                    "training_fitted",
+                    "calibration_scored",
+                    "validation_scored",
+                    "actionable_alerts",
+                    "incremental_review_count",
+                    "verified_outlier_alerts",
+                )
+            }
+        )
+        for key, row in decisions.items():
+            ml = row.findings.get("ml", {})
+            anomalies = [
+                (pair[scope]["feature"], scope)
+                for pair in row.findings["statistics"]
+                for scope in ("team", "profession")
+                if pair[scope]["status"] == "anomaly"
+            ]
+            print(
+                key,
+                row.decision,
+                row.ml_score,
+                ml.get("qualifies_for_review"),
+                anomalies,
+                row.reason,
+            )
+        assert set(decisions) == {"NEXT-01", "NEXT-02", "NEXT-07"}
+        assert model.status == "ACTIVE"
+        assert decisions["NEXT-01"].decision == "MANUAL_REVIEW"
+        assert decisions["NEXT-01"].findings["ml"]["qualifies_for_review"] is True
+        assert decisions["NEXT-01"].cluster_id is None
+        assert decisions["NEXT-02"].decision == "APPROVE"
+        case = decisions["NEXT-07"]
+        assert case.decision == "MANUAL_REVIEW"
+        assert case.ml_score > model.anomaly_threshold
+        assert case.findings["ml"]["qualifies_for_review"] is True
+        assert not case.findings["fraud"]["established_exposure"] and case.cluster_id is None
+        assert all(
+            pair[scope]["status"] != "anomaly"
+            for pair in case.findings["statistics"]
+            for scope in ("team", "profession")
+        )
