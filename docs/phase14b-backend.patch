+    def score_many(self, vectors: tuple[ModelVector, ...]) -> tuple[tuple[float | None, int], ...]:
+        transformed = [self.preprocessing.transform(numeric_vector(vector)) for vector in vectors]
+        scoring_rows = [row for row, _ in transformed if row is not None]
+        if not scoring_rows:
+            return tuple((None, count) for _, count in transformed)
+        scores = -self.estimator.score_samples(np.stack(scoring_rows))
+        if not np.isfinite(scores).all():
+            raise ValueError("invalid_anomaly_score")
+        ordered = iter(scores)
+        return tuple(
+            (float(next(ordered)) if row is not None else None, count) for row, count in transformed
+        )
+
 
